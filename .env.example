# Studio A by Nancy - environment variables
# Copy to .env.local for local development.

# Site
NEXT_PUBLIC_SITE_URL="https://studioabynancy.com"

# Resend (transactional email) - optional; without it submissions log to console
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Studio A by Nancy <nancy@studioabynancy.com>"
RESEND_TO_EMAIL="nancy@studioabynancy.com"

# Supabase - optional; without it leads are only emailed
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash rate limiting - optional; without it rate-limiting is a no-op
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sanity - optional; without it portfolio uses placeholder data
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""

# Cal.com - optional; "studioabynancy/consultation" recommended
NEXT_PUBLIC_CAL_LINK=""
